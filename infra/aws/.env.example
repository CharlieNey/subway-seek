# Copy to /opt/stand-clear/.env on the instance. Never commit the real one.

# The ECR image the compose file runs (the deploy updates the tag).
IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/stand-clear-server:latest
# The server's domain: the A record points at the instance's Elastic IP. Caddy gets its
# certificate for this name, so the record has to exist before the first start.
SERVER_HOST=play-api.example.com

# Mixed into the daily's seed so nobody can compute today's answer from the client code.
# `openssl rand -base64 32`. Changing it changes every future daily.
DAILY_SECRET=
# The server key (Street View API only): picks hiding spots and checks walks. Free lookups.
GOOGLE_STREETVIEW_SERVER_KEY=
# The browser key and the URL signing secret: the server signs each photo's image URL.
GOOGLE_MAPS_BROWSER_KEY=
STREETVIEW_SIGNING_SECRET=
