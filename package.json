{
  "name": "subway-seek",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:build": "pnpm --filter @subway-seek/data build-dataset",
    "data:check": "pnpm --filter @subway-seek/data check-dataset",
    "dev:server": "pnpm --filter @subway-seek/server dev",
    "dev:web": "pnpm --filter @subway-seek/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sim": "pnpm --filter @subway-seek/engine sim",
    "sim:endgame": "pnpm --filter @subway-seek/engine sim:endgame",
    "sim:match": "pnpm --filter @subway-seek/engine sim:match",
    "sim:hide": "pnpm --filter @subway-seek/engine sim:hide",
    "metrics": "pnpm --filter @subway-seek/server metrics",
    "data:hardness": "pnpm --filter @subway-seek/web hardness",
    "rename": "tsx scripts/rename.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
